# Адреса обробника заявок. Сюди надходить POST-запит у форматі JSON:
# { name, contact, services: string[], budget?, message }
# Якщо змінна порожня, форми відкривають лист на адресу агенції.
NEXT_PUBLIC_REQUEST_ENDPOINT=

# PostgreSQL — use a connection URL from your database provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin access. Use long, unique secrets in .env.local; do not commit them.
ADMIN_PASSWORD="replace-with-a-long-unique-password"
ADMIN_SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
ANALYTICS_HASH_SECRET="replace-with-another-random-secret-at-least-32-characters"
