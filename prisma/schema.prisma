generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Visit {
  id           String   @id @default(cuid())
  visitedAt    DateTime @default(now()) @db.Timestamptz(3)
  ipAddress    String?
  visitorKey   String
  country      String?  @db.VarChar(2)
  device       String   @db.VarChar(20)
  browser      String   @db.VarChar(30)
  path         String   @db.VarChar(500)
  referrerHost String?  @db.VarChar(255)

  @@index([visitedAt])
  @@index([visitorKey, visitedAt])
  @@index([country, visitedAt])
  @@index([device, visitedAt])
  @@index([path, visitedAt])
}

model ServicePageContent {
  slug      String   @id @db.VarChar(80)
  content   Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Проєкти портфоліо: картка + уся сторінка кейсу в content (див. lib/project-docs.ts).
model ProjectEntry {
  slug      String   @id @db.VarChar(80)
  position  Int      @default(0)
  published Boolean  @default(true)
  content   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([position])
}

/// Статті блогу: метадані + тіло з блоків у content (див. lib/blog-docs.ts).
model BlogPost {
  slug      String   @id @db.VarChar(120)
  published Boolean  @default(false)
  content   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
